{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "functions": {
    "api/store.js": {
      "includeFiles": "{tienda.html,landing.html,ayuda.html,dejar-resena.html,dashboard.html,alta-usuario.html,super-admin-secret-dashboard.html,kit-imprimible.html}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/ayuda",
      "destination": "/ayuda.html"
    },
    {
      "source": "/dejar-resena",
      "destination": "/dejar-resena.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/alta-usuario",
      "destination": "/alta-usuario.html"
    },
    {
      "source": "/kit-imprimible",
      "destination": "/kit-imprimible.html"
    },
    {
      "source": "/super-admin-secret-dashboard",
      "destination": "/super-admin-secret-dashboard.html"
    },
    {
      "source": "/landing",
      "destination": "/landing.html"
    },
    {
      "source": "/",
      "destination": "/api/store"
    },
    {
      "source": "/:path*",
      "destination": "/api/store"
    }
  ]
}
