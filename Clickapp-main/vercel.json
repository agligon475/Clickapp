{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "functions": {
    "api/store.js": {
      "includeFiles": "*.html"
    },
    "api/auth.js": {
      "includeFiles": "api/email-templates.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/desarrollo",
      "destination": "/desarrollo.html"
    },
    {
      "source": "/desarrollo.html",
      "destination": "/desarrollo.html"
    },
    {
      "source": "/enviar-comprobante",
      "destination": "/enviar-comprobante.html"
    },
    {
      "source": "/ayuda",
      "destination": "/ayuda.html"
    },
    {
      "source": "/dejar-resena",
      "destination": "/dejar-resena.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/alta-usuario",
      "destination": "/alta-usuario.html"
    },
    {
      "source": "/kit-imprimible",
      "destination": "/kit-imprimible.html"
    },
    {
      "source": "/super-admin-secret-dashboard",
      "destination": "/super-admin-secret-dashboard.html"
    },
    {
      "source": "/landing",
      "destination": "/landing.html"
    },
    {
      "source": "/terminos",
      "destination": "/terminos.html"
    },
    {
      "source": "/terminos-y-condiciones",
      "destination": "/terminos.html"
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/politicas-de-privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/",
      "destination": "/api/store"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/.well-known/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api/store"
    }
  ]
}
