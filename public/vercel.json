{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(?:png|jpg|jpeg|gif|svg|ico|webp)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "functions": {
    "api/store.js": {
      "includeFiles": "{*.html,*.css,*.png,*.ico,*.svg,*.jpg,*.jpeg,img/**,img-default/**,widgets/**,bgd-samples/**}"
    },
    "api/auth.js": {
      "includeFiles": "api/email-templates.js"
    }
  },
  "redirects": [
    {
      "source": "/descargar-app",
      "destination": "https://github.com/agligon475/Clickapp/releases/latest/download/DaleTePido.apk",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "https://github.com/agligon475/Clickapp/releases/latest/download/DaleTePido.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/twa-manifest.json",
      "destination": "/twa-manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/js/(.*)",
      "destination": "/js/$1"
    },
    {
      "source": "/img/(.*)",
      "destination": "/img/$1"
    },
    {
      "source": "/img-default/(.*)",
      "destination": "/img-default/$1"
    },
    {
      "source": "/videos/(.*)",
      "destination": "/videos/$1"
    },
    {
      "source": "/widgets/(.*)",
      "destination": "/widgets/$1"
    },
    {
      "source": "/bgd-samples/(.*)",
      "destination": "/bgd-samples/$1"
    },
    {
      "source": "/vov.min.css",
      "destination": "/vov.min.css"
    },
    {
